# Copy to .env.local and adjust if the agents run somewhere other than localhost.
# No NEXT_PUBLIC_ prefix: these are read server-side only, by
# app/api/[agent]/chat/stream/route.ts, which proxies the browser's same-origin
# fetch to the actual agent backend. Keeping them server-only means the browser
# never makes a cross-origin (or http:// from https://) call directly.
AGENT_CORTEX_URL=http://127.0.0.1:8000
AGENT_CLAUDE_URL=http://127.0.0.1:8001
